[Unit]
Description=Arahin Daemon — Route planning AI agent
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/arahin daemon
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/.local/state/arahin /root/.config/arahin

[Install]
WantedBy=multi-user.target
